{
  "name": "helpdesk-ticket-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n server,client \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "test": "npm test --workspace=client && npm test --workspace=server",
    "test:integration": "npm run test:integration --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
